@page "/cursos"

<PageTitle>Cursos | UpSkills</PageTitle>

<div class="sub_page">
    <div class="hero_area">
        <NavMenu />
    </div>

    <!-- Filtros y búsqueda -->
    <section class="layout_padding2-top layout_padding2-bottom" style="background-color:#f2f3f4;">
        <div class="container">
            <div class="custom_heading-container mb-4">
                <h2>Catálogo de Cursos</h2>
            </div>

            <div class="row">
                <!-- Buscador -->
                <div class="col-md-4 mb-3">
                    <input type="text" class="form-control" placeholder="Buscar cursos..." @bind="Busqueda" @bind:event="oninput" @onkeyup="OnBusquedaKeyUp" />
                </div>
                <!-- Categoría -->
                <div class="col-md-2 mb-3">
                    <select class="form-control" @bind="CategoriaSeleccionada" @bind:event="oninput" @onchange="OnFiltroChange">
                        <option value="">Todas las categorías</option>
                        @foreach (var cat in Categorias)
                        {
                            <option value="@cat.Id">@cat.Nombre</option>
                        }
                    </select>
                </div>
                <!-- Precio máximo -->
                <div class="col-md-2 mb-3">
                    <input type="number" class="form-control" placeholder="Precio máximo" @bind="PrecioMax" @bind:event="oninput" @onchange="OnFiltroChange" min="0" />
                </div>
                <!-- Duración máxima -->
                <div class="col-md-2 mb-3">
                    <input type="number" class="form-control" placeholder="Horas máx." @bind="DuracionMax" @bind:event="oninput" @onchange="OnFiltroChange" min="0" />
                </div>
                <!-- Botón buscar -->
                <div class="col-md-2 mb-3">
                    <button class="btn-upskills-primary w-100" @onclick="BuscarCursos">Buscar</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Listado de cursos -->
    <section class="layout_padding">
        <div class="container">
            @if (Cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border" style="color:#864ddf;" role="status">
                        <span class="sr-only">Cargando...</span>
                    </div>
                    <p class="mt-3" style="color:#864ddf;">Cargando cursos...</p>
                </div>
            }
            else if (!Cursos.Any())
            {
                <div class="text-center py-5">
                    <h4 style="color:#864ddf;">No se encontraron cursos</h4>
                    <p>Intenta con otros filtros de búsqueda.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var curso in Cursos)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="curso-card h-100">
                                <div class="curso-card-img">
                                    @if (!string.IsNullOrEmpty(curso.Imagen))
                                    {
                                        <img src="@curso.Imagen" alt="@curso.Titulo" />
                                    }
                                    else
                                    {
                                        <div class="curso-card-img-placeholder">
                                            <span>@curso.CategoriaNombre</span>
                                        </div>
                                    }
                                    <span class="curso-badge">@curso.CategoriaNombre</span>
                                </div>
                                <div class="curso-card-body">
                                    <h5>@curso.Titulo</h5>
                                    <p class="curso-instructor">Por @curso.InstructorNombre</p>
                                    <p class="curso-descripcion">@(curso.Descripcion.Length > 100 ? curso.Descripcion[..100] + "..." : curso.Descripcion)</p>
                                    <div class="curso-meta">
                                        <span><i class="curso-icon-clock"></i> @curso.Duracion h</span>
                                        <span><i class="curso-icon-users"></i> @curso.TotalInscritos inscritos</span>
                                        <span><i class="curso-icon-modules"></i> @curso.TotalModulos módulos</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="curso-precio">@(curso.Precio == 0 ? "Gratis" : $"${curso.Precio:N0}")</span>
                                        <a href="/cursos/@curso.Id" class="btn-upskills-sm">Ver curso</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Paginación -->
                @if (TotalPaginas > 1)
                {
                    <div class="d-flex justify-content-center mt-4">
                        <nav>
                            <ul class="pagination upskills-pagination">
                                <li class="page-item @(PaginaActual <= 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(PaginaActual - 1)" disabled="@(PaginaActual <= 1)">
                                        &laquo;
                                    </button>
                                </li>
                                @for (int p = Math.Max(1, PaginaActual - 2); p <= Math.Min(TotalPaginas, PaginaActual + 2); p++)
                                {
                                    int pagNum = p;
                                    <li class="page-item @(pagNum == PaginaActual ? "active" : "")">
                                        <button class="page-link" @onclick="() => CambiarPagina(pagNum)">@pagNum</button>
                                    </li>
                                }
                                <li class="page-item @(PaginaActual >= TotalPaginas ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(PaginaActual + 1)" disabled="@(PaginaActual >= TotalPaginas)">
                                        &raquo;
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                    <p class="text-center text-muted mt-2">
                        Mostrando página @PaginaActual de @TotalPaginas (@TotalItems cursos en total)
                    </p>
                }
            }
        </div>
    </section>
</div>
