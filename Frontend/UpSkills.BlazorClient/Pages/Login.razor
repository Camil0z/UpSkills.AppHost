@page "/login"
@inject IJSRuntime JS

<PageTitle>Ingresar | UpSkills</PageTitle>

<div class="sub_page">
    <div class="hero_area">
        <NavMenu />
    </div>

    <section class="contact_section layout_padding">
        <div class="container contact_heading">
            <h2>Ingresa a tu cuenta</h2>
            <p>Completa los campos para ingresar. Si no tienes cuenta, regístrate para empezar a aprender.</p>
        </div>

        <div class="container" style="max-width:550px;">
            @if (!string.IsNullOrEmpty(MensajeError))
            {
                <div class="alert alert-danger">@MensajeError</div>
            }
            @if (!string.IsNullOrEmpty(MensajeExito))
            {
                <div class="alert alert-success">@MensajeExito</div>
            }

            <form @onsubmit="HandleLogin">
                <div class="form-group">
                    <label>Correo electrónico</label>
                    <input type="email" class="form-control" @bind="Correo" placeholder="correo@ejemplo.com" required />
                </div>
                <div class="form-group">
                    <label>Contraseña</label>
                    <input type="password" class="form-control" @bind="Contrasena" placeholder="••••••••" required />
                </div>

                <div class="d-flex justify-content-center mt-4" style="gap:12px;">
                    <button type="submit" class="btn-upskills-primary" disabled="@Cargando">
                        @(Cargando ? "Ingresando..." : "Ingresar")
                    </button>
                    <a href="/register" class="btn-upskills-secondary">Registrarse</a>
                </div>
            </form>
        </div>
    </section>
</div>
