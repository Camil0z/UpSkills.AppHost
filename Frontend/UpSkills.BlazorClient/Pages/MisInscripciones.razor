@page "/mis-inscripciones"
@inject IJSRuntime JS

<PageTitle>Mis Inscripciones | UpSkills</PageTitle>

<div class="sub_page">
    <div class="hero_area">
        <NavMenu />
    </div>

    <section class="layout_padding">
        <div class="container">
            <div class="custom_heading-container mb-4">
                <h2>Mis Inscripciones</h2>
            </div>

            @if (Cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border" style="color:#864ddf;"></div>
                    <p class="mt-3" style="color:#864ddf;">Cargando inscripciones...</p>
                </div>
            }
            else if (!Inscripciones.Any())
            {
                <div class="text-center py-5">
                    <h5 style="color:#864ddf;">No tienes inscripciones aún</h5>
                    <p>Explora nuestro catálogo y comienza a aprender.</p>
                    <a href="/cursos" class="btn-upskills-primary">Ver cursos</a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var ins in Inscripciones)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="inscripcion-card">
                                @if (!string.IsNullOrEmpty(ins.CursoImagen))
                                {
                                    <img src="@ins.CursoImagen" alt="@ins.CursoTitulo" class="inscripcion-img" />
                                }
                                else
                                {
                                    <div class="inscripcion-img-placeholder"></div>
                                }
                                <div class="inscripcion-body">
                                    <h6>@ins.CursoTitulo</h6>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="badge-estado estado-@ins.EstadoId">@ins.Estado</span>
                                        <span class="text-muted" style="font-size:0.8rem;">
                                            @ins.FechaInscripcion.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                    <div class="mt-2" style="font-size:0.85rem; color:#555;">
                                        <span><strong>Valor:</strong> @(ins.Valor == 0 ? "Gratis" : $"${ins.Valor:N0}")</span>
                                        @if (!string.IsNullOrEmpty(ins.Referencia))
                                        {
                                            <span class="ml-3"><strong>Ref:</strong> @ins.Referencia</span>
                                        }
                                    </div>
                                    <a href="/cursos/@ins.CursoId" class="btn-upskills-sm mt-3" style="display:inline-block;">
                                        Ver curso
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>
