@inject IJSRuntime JS
@inject NavigationManager Nav

<!-- header section strats -->
<header class="header_section">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-10">
                <nav class="navbar navbar-expand-lg custom_nav-container ">
                    <a class="navbar-brand" href="">
                        <span>UpSkills</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-toggle="collapse"
                            data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <div class="d-flex flex-column flex-lg-row align-items-center">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link" href="/">Explorar</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/cursos">Cursos</a>
                                </li>
                                @if (SesionActiva)
                                {
                                    @if (EsInstructor)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" href="/instructor/cursos">Mis cursos</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" href="/mis-inscripciones">Mis inscripciones</a>
                                        </li>
                                    }
                                    <li class="nav-item">
                                        <span class="nav-link" style="color:#feb543; cursor:default;">@NombreUsuario</span>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link btn btn-link" style="color:#f9fcfb;" @onclick="CerrarSesion">Salir</button>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" href="/login">Ingresar</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/register">Registro</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>
</header>
<!-- end header section -->

@code {
    bool SesionActiva = false;
    bool EsInstructor = false;
    string NombreUsuario = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var nombre = await JS.InvokeAsync<string?>("localStorage.getItem", "upskills_nombre");
            var rol = await JS.InvokeAsync<string?>("localStorage.getItem", "upskills_rol");
            SesionActiva = !string.IsNullOrEmpty(nombre);
            EsInstructor = rol == "Instructor";
            NombreUsuario = nombre ?? string.Empty;
            StateHasChanged();
        }
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "upskills_token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "upskills_userId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "upskills_rol");
        await JS.InvokeVoidAsync("localStorage.removeItem", "upskills_nombre");
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
